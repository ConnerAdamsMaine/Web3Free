# ============================================================================
# Backend API Environment Configuration
# ============================================================================
# SECURITY: Never commit .env file to version control
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web3domains
DB_USER=web3domains_app
DB_PASSWORD=your_secure_database_password_here
DB_SSL=false

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ----------------------------------------------------------------------------
# Ethereum Blockchain Configuration
# ----------------------------------------------------------------------------
# Smart contract address (from deployment)
CONTRACT_ADDRESS=0x...

# RPC endpoint (Infura, Alchemy, or local node)
ETHEREUM_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_NETWORK=goerli
CHAIN_ID=5

# Verifier wallet (authorized to confirm paid registrations)
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_ADDRESS=0x...

# Gas settings
GAS_LIMIT=500000
GAS_PRICE=auto

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# JWT secret for session tokens (generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Session configuration
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=86400000

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your_encryption_key_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# Stripe Payment Configuration
# ----------------------------------------------------------------------------
# SECURITY: Use test keys in development, live keys in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Atlas configuration (for business verification)
STRIPE_ATLAS_ENABLED=true

# Payment settings
DOMAIN_REGISTRATION_FEE=9.99
CURRENCY=usd

# ----------------------------------------------------------------------------
# Profit Verification Configuration
# ----------------------------------------------------------------------------
# Profit threshold for additional domains (in USD)
PROFIT_THRESHOLD=10000

# Verification settings
AUTO_APPROVE_STRIPE_ATLAS=true
MANUAL_REVIEW_REQUIRED=false
VERIFICATION_EXPIRY_DAYS=365

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------
# AWS S3 for document storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=web3domains-documents

# File upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg

# ----------------------------------------------------------------------------
# Email Configuration
# ----------------------------------------------------------------------------
# SMTP settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@web3domains.com

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# API rate limiting (requests per time window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Registration rate limiting (domains per day per wallet)
REGISTRATION_RATE_LIMIT=10

# ----------------------------------------------------------------------------
# Logging & Monitoring
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Error tracking (Sentry, etc.)
SENTRY_DSN=

# Analytics
ANALYTICS_ENABLED=false

# ----------------------------------------------------------------------------
# Compliance & Legal
# ----------------------------------------------------------------------------
# KYC/AML provider configuration
KYC_PROVIDER=stripe_identity
KYC_REQUIRED_FOR_PAID_DOMAINS=false

# GDPR compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=730

# Terms of Service version
TOS_VERSION=1.0
TOS_URL=https://web3domains.com/terms

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------
# Redis (optional, for caching and session storage)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# In-memory cache settings
CACHE_TTL=300
CACHE_CHECK_PERIOD=60

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features
ENABLE_DOMAIN_REGISTRATION=true
ENABLE_PROFIT_VERIFICATION=true
ENABLE_STRIPE_PAYMENTS=true
ENABLE_CRYPTO_PAYMENTS=false
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOGS=true

# Beta features
ENABLE_GASLESS_REGISTRATION=false
ENABLE_SUBDOMAIN_SUPPORT=false
ENABLE_DOMAIN_MARKETPLACE=false

# ----------------------------------------------------------------------------
# Development & Testing
# ----------------------------------------------------------------------------
# Mock external services in development
MOCK_STRIPE=false
MOCK_BLOCKCHAIN=false
MOCK_EMAIL=true

# Test mode
TEST_MODE=false
