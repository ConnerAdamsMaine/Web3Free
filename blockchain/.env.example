# Web3Browse Blockchain Node Configuration

# Node API
API_PORT=3001
P2P_PORT=9000
P2P_WS_PORT=9001

# Bootstrap peers (comma-separated libp2p multiaddrs)
BOOTSTRAP_PEERS=/ip4/127.0.0.1/tcp/9000/p2p/QmBootstrapPeerID

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Database
DATA_DIR=./data

# Network
NETWORK_ID=web3browse
CHAIN_ID=1337

# Block production
BLOCK_TIME=3000
MAX_TRANSACTIONS_PER_BLOCK=100
DIFFICULTY=2

# Rewards
MINING_REWARD=50
BROWSING_REWARD=5

# Validator requirements
MIN_VALIDATORS=3
MAX_VALIDATORS=21
VALIDATOR_TIMEOUT=30000

# API CORS
CORS_ORIGINS=*
